# Google Drive OAuth2 credentials
# Obtain these from: https://console.cloud.google.com/
# Required OAuth2 scope: https://www.googleapis.com/auth/drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional: override the default redirect URI (used during initial OAuth consent flow)
# Defaults to "urn:ietf:wg:oauth:2.0:oob" (desktop/out-of-band flow)
GOOGLE_DRIVE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Optional: default Drive folder ID to upload files into
# Leave empty to upload to the root of My Drive
GOOGLE_DRIVE_FOLDER_ID=
