{"level":30,"time":1782736144547,"pid":12892,"hostname":"YogaBook9i","app":"Private Cloud Backend","payload":{"event":"entry.publish","createdAt":"2026-06-29T12:29:04.509Z","model":"updated-resume","uid":"api::updated-resume.updated-resume","entry":{"id":30,"documentId":"zqedekjbl2zytjbowpma4h1i","name":"Gonzalo salvador corvalán","createdAt":"2026-06-26T19:15:57.301Z","updatedAt":"2026-06-29T12:29:04.286Z","publishedAt":"2026-06-29T12:29:04.413Z","title":"fullstack software engineer","email":"gonzalosalvadorcorvalan@gmail.com","website":"www.corvalangonzalo.com","github_profile_link":"github.com/TheMrCorvy","background_rich_text":"With a strong background in web development gained through years of Fullstack work.\nSkilled in Frontend and Backend web technologies such as HTML, CSS, JavaScript, Next JS, TypeScript, and\nNode.JS.\nProven ability to work independently and meet tight deadlines while ensuring high-quality code.\n","education_list_items":[{"id":46,"title":"SYSTEMS ANALYST, BACHELOR OF INFORMATICS","institute":"Interamerican Open University","country":"Buenos Aires, Argentina.","from":"2023","until":"2025"},{"id":47,"title":"JAPANESE LANGUAGE","institute":"ISI Language School","country":"Kyoto, Japan","from":"2022","until":"2023"},{"id":48,"title":"ENGLISH LANGUAGE","institute":"CUI (University Language Center)","country":"Buenos Aires, Argentina.","from":"2018","until":"2022"}],"experience_list_items":[{"id":46,"position":"fullstack developer","location":"United States, remotely","from":"October 2023","until":"Present","description":"Currently engaged as a **Fullstack Node.JS** with **TypeScript** developer, leveraging expertise in React.JS framework, Next JS.\n- Developing together with the Backend team a new flow to handle users’ identification, and implementing the system\nacross multiple API consumer apps.\n- Coordinating tasks with multiple team members from different sectors such as design, UX/UI, Backend, and DevOps.\n- Development focused on customer satisfaction and computer security.","company":"GlobalLogic","client":"Verizon"},{"id":47,"position":"FRONTEND REACT DEVELOPER","location":"United States, remotely.","from":"December 2023","until":"April 2024","description":"Short-term side-job where I performed as a Frontend developer for a fintech located in the US, helping on the migration from a **GraphQL** integration to a **REST API** approach, while following the **SOLID** principles and making use of tools such as ES Lint and Prettier to ensure good code quality","company":"finalis","client":null},{"id":48,"position":"FRONTEND DEVELOPER","location":"Kyoto, Japan.","from":"April 2022","until":"March 2023","description":"Contributed to the web development team for a prestigious hotel in Kyoto. Among other things, my tasks included translating documentation from Japanese to English, updating old Class-based components to hooks and server-side rendering with Next JS and TypeScript, and helping in the process of restructuring the project’s internal architecture to follow the principles of **Clean Architecture**.","company":"TSUMUGI HOTEL","client":null}],"web_portfolio_qr_code":{"id":24,"documentId":"j06wfn6zpnbqyw1sz6g31ykn","name":"f519a5ac447dbdc95aa23a3fc2aeca5e.png","alternativeText":null,"caption":null,"width":1584,"height":1584,"formats":{"thumbnail":{"name":"thumbnail_f519a5ac447dbdc95aa23a3fc2aeca5e.png","hash":"thumbnail_f519a5ac447dbdc95aa23a3fc2aeca5e_3b6101cfad","ext":".png","mime":"image/png","path":null,"width":156,"height":156,"size":14.4,"sizeInBytes":14404,"url":"/uploads/thumbnail_f519a5ac447dbdc95aa23a3fc2aeca5e_3b6101cfad.png"},"large":{"name":"large_f519a5ac447dbdc95aa23a3fc2aeca5e.png","hash":"large_f519a5ac447dbdc95aa23a3fc2aeca5e_3b6101cfad","ext":".png","mime":"image/png","path":null,"width":1000,"height":1000,"size":43.34,"sizeInBytes":43341,"url":"/uploads/large_f519a5ac447dbdc95aa23a3fc2aeca5e_3b6101cfad.png"},"medium":{"name":"medium_f519a5ac447dbdc95aa23a3fc2aeca5e.png","hash":"