{
    "name": "chaldea-foundation",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "format:check": "prettier --check .",
        "check-types": "turbo run check-types",
        "prepare": "node .husky/install.mjs",
        "test": "turbo run test",
        "test:coverage": "turbo test:coverage",
        "clean": "turbo clean",
        "start": "turbo run start",
        "generate:sdk": "pnpm --dir apps/chaldea-foundation-center exec strapi openapi generate -- --output ../../specs/spec.json && pnpm exec openapi-ts",
        "patch:sdk-types": "node ./scripts/patch-sdk.config.js",
        "generate:mock-sdk": "node scripts/generate-mock-sdk.js",
        "initialize:platform-sdk": "pnpm run generate:sdk && pnpm run patch:sdk-types && pnpm run generate:mock-sdk",
        "initialize:private-cloud-db": "pnpm --dir apps/private-cloud-backend run initialize:db",
        "projection-magic": "bash scripts/verify-ports.sh",
        "initialize:backup": "tsx scripts/time-machine.ts",
        "initialize:backup-restoration": "tsx scripts/speedwagon-rescue.ts",
        "verify:drive-auth": "tsx scripts/connect-with-SERN.ts"
    },
    "devDependencies": {
        "@eslint/js": "^9.31.0",
        "@hey-api/openapi-ts": "0.88.0",
        "@types/node": "^25.5.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "esbuild": "^0.25.9",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "husky": "^9.1.7",
        "lint-staged": "^15.3.0",
        "prettier": "^3.6.2",
        "turbo": "^2.5.6",
        "tsx": "^4.20.6",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": "<=22.x.x"
    },
    "packageManager": "pnpm@11.1.1",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "dependencies": {
        "@repo/remote-storage": "workspace:*",
        "@strapi/strapi": "^5.23.0",
        "@vercel/speed-insights": "^1.3.1",
        "rimraf": "^6.0.0",
        "uuid": "^11.1.0"
    },
    "overrides": {
        "@types/react": "^19.1.2"
    },
    "lint-staged": {
        "src/**/*.{ts,js}": [
            "eslint --fix",
            "prettier --check"
        ],
        "*.{json,md}": [
            "prettier --check"
        ]
    }
}
