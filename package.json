{
    "name": "chaldea-foundation",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "format:check": "prettier --check .",
        "check-types": "turbo run check-types",
        "prepare": "husky",
        "test": "turbo run test",
        "test:coverage": "turbo test:coverage",
        "clean": "turbo clean",
        "start": "turbo run start",
        "generate:sdk": "cd apps/chaldea-foundation-center && npm run strapi openapi generate -- --output ../../specs/spec.json && cd ../.. && npx @hey-api/openapi-ts",
        "patch:sdk-types": "node ./scripts/patch-sdk.config.js",
        "generate:mock-sdk": "node scripts/generate-mock-sdk.js",
        "initialize:platform-sdk": "npm run generate:sdk && npm run patch:sdk-types && npm run generate:mock-sdk",
        "initialize:private-cloud-db": "cd ./apps/private-cloud-backend && npm run initialize:db",
        "projection-magic": "bash scripts/verify-ports.sh"
    },
    "devDependencies": {
        "@eslint/js": "^9.31.0",
        "@hey-api/openapi-ts": "0.88.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "esbuild": "^0.25.9",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "husky": "^9.1.7",
        "lint-staged": "^15.3.0",
        "prettier": "^3.6.2",
        "turbo": "^2.5.6",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "npm@11.4.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "dependencies": {
        "@strapi/strapi": "^5.23.0",
        "rimraf": "^6.0.0",
        "uuid": "^11.1.0"
    },
    "overrides": {
        "@types/react": "^19.1.2"
    },
    "lint-staged": {
        "src/**/*.{ts,js}": [
            "eslint --fix",
            "prettier --check"
        ],
        "*.{json,md}": [
            "prettier --check"
        ]
    }
}
