{
    "name": "private-cloud-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "next build",
        "start": "next start -p 3000",
        "lint": "eslint",
        "test": "jest",
        "test:watch": "jest --watch",
        "deploy": "pnpm --dir ../../ exec openapi-ts && pnpm --dir ../../ run patch:sdk-types && pnpm --dir ../../ run generate:mock-sdk && pnpm run build",
        "storybook": "storybook dev -p 6007",
        "build-storybook": "storybook build",
        "serve-storybook": "pnpm run build-storybook && http-server ./storybook-static -p 6007"
    },
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/inter": "^5.2.8",
        "@mui/icons-material": "^7.3.6",
        "@mui/joy": "^5.0.0-beta.52",
        "@mui/material": "^7.3.11",
        "@repo/config": "workspace:*",
        "@repo/platform-service-sdk": "workspace:*",
        "@repo/shared-utils": "workspace:*",
        "@repo/type-definitions": "workspace:*",
        "http-server": "^14.1.1",
        "next": "^16.1.6",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-qr-code": "^2.0.18"
    },
    "devDependencies": {
        "@jest/types": "^30.4.1",
        "@storybook/nextjs": "^10.5.0",
        "@storybook/nextjs-vite": "^10.2.8",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.0.7",
        "eslint-plugin-storybook": "^10.2.8",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "storybook": "^10.2.8",
        "ts-jest": "^29.4.6",
        "typescript": "^5",
        "vite": "^7.3.1"
    }
}
