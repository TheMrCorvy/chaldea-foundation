        "@mui/joy": "5.0.0-beta.52",
        "@mui/lab": "9.0.0-beta.3",
        "@mui/material": "^7.3.8",
        "@mui/material-nextjs": "^7.3.7",
        "@mui/system": "^9.0.1",
        "@repo/platform-service-sdk": "workspace:*",
        "@repo/shared-utils": "workspace:*",
        "@repo/type-definitions": "workspace:*",
        "@salvatore.hakase/log-data": "^1.0.1",
        "@vercel/analytics": "^1.6.1",
        "d3": "^7.9.0",
        "framer-motion": "^11.11.13",
        "http-server": "^14.1.1",
