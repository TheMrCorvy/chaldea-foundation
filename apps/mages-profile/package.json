        "@types/d3": "^7.4.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.1.4",
        "eslint-plugin-storybook": "^10.2.8",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "storybook": "^10.2.8",
        "ts-jest": "^29.4.6",
