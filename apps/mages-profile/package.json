        "serve-storybook": "pnpm run build-storybook && http-server ./storybook-static -p 6006",
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
