# Server Configuration
HOST=0.0.0.0
PORT=1337

# Security Keys
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database Configuration
# Default: SQLite for development
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Seeder Configuration
# Seeders are run manually via npm scripts:
# npm run seed        - Run seeders (skip if data exists)
# npm run seed:force  - Force run seeders
# npm run seed:reset  - Clear and reseed
# This variable is kept for backward compatibility but seeders no longer run automatically
RUN_SEEDERS=false

# Environment
NODE_ENV=development
