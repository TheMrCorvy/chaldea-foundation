{
    "collectionName": "components_blog_blog_texts",
    "info": {
        "displayName": "Blog Text",
        "icon": "quote"
    },
    "options": {},
    "attributes": {
        "component_id": {
            "type": "string",
            "unique": true
        },
        "title": {
            "type": "string",
            "required": false
        },
        "body": {
            "type": "blocks",
            "required": true
        },
        "font_size": {
            "type": "string"
        },
        "line_height": {
            "type": "decimal"
        },
        "color": {
            "type": "string",
            "default": "#eeeeee"
        },
        "text_align": {
            "type": "enumeration",
            "required": false,
            "default": "left",
            "enum": ["center", "left", "right"]
        },
        "highlighted_text_color": {
            "type": "enumeration",
            "default": "primary",
            "enum": [
                "primary",
                "secondary",
                "warning",
                "info",
                "error",
                "success",
                "inherit"
            ]
        }
    },
    "config": {}
}
