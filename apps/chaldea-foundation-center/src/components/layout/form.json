{
    "collectionName": "components_layout_forms",
    "info": {
        "displayName": "Form",
        "icon": "paperPlane"
    },
    "options": {},
    "attributes": {
        "component_id": {
            "type": "string",
            "unique": true
        },
        "title": {
            "type": "string"
        },
        "inputs": {
            "type": "component",
            "component": "layout.form-input",
            "repeatable": true,
            "required": true
        },
        "action": {
            "type": "string",
            "minLength": 1,
            "required": true
        },
        "method": {
            "type": "enumeration",
            "required": true,
            "default": "post",
            "enum": ["post", "get", "put", "delete"]
        }
    },
    "config": {}
}
