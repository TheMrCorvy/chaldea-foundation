{
    "collectionName": "components_layout_links",
    "info": {
        "displayName": "Link",
        "icon": "link"
    },
    "options": {},
    "attributes": {
        "component_id": {
            "type": "string",
            "unique": true
        },
        "title": {
            "type": "string"
        },
        "label": {
            "type": "string",
            "required": true
        },
        "href": {
            "type": "string",
            "required": true
        },
        "popover": {
            "type": "string"
        },
        "variant": {
            "type": "enumeration",
            "required": true,
            "default": "link",
            "enum": ["link", "icon_link", "link_with_icon"]
        },
        "icon": {
            "type": "component",
            "component": "layout.icon",
            "repeatable": false
        },
        "target": {
            "type": "enumeration",
            "default": "_self",
            "enum": ["_self", "_blank", "_parent", "_top"]
        },
        "color": {
            "type": "enumeration",
            "default": "primary",
            "enum": [
                "primary",
                "secondary",
                "warning",
                "info",
                "error",
                "success",
                "inherit"
            ]
        },
        "size": {
            "type": "enumeration",
            "required": true,
            "default": "inherit",
            "enum": [
                "body1",
                "body2",
                "button",
                "caption",
                "h1",
                "h2",
                "h3",
                "h4",
                "h5",
                "h6",
                "inherit",
                "overline",
                "subtitle1",
                "subtitle2"
            ]
        }
    },
    "config": {}
}
