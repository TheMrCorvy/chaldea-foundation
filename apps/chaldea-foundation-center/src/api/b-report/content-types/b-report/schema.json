{
    "kind": "collectionType",
    "collectionName": "b_reports",
    "info": {
        "singularName": "b-report",
        "pluralName": "b-reports",
        "displayName": "B - Reports"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "description": {
            "type": "text",
            "required": true
        },
        "media": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images", "videos"]
        },
        "state": {
            "type": "enumeration",
            "default": "pending",
            "enum": ["pending", "resolved", "failed"]
        },
        "type_of_report": {
            "type": "string"
        },
        "job_id": {
            "type": "integer"
        }
    }
}
