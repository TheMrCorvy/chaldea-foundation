{
    "kind": "collectionType",
    "collectionName": "a_social_media_posts",
    "info": {
        "singularName": "a-social-media-post",
        "pluralName": "a-social-media-posts",
        "displayName": "A - Social Media Post"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150,
            "required": true
        },
        "Body": {
            "type": "text",
            "required": true
        },
        "cover_image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images", "files"]
        },
        "video": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["files", "videos"]
        },
        "hasgtags": {
            "type": "component",
            "component": "layout.tool-chip",
            "repeatable": true
        }
    }
}
