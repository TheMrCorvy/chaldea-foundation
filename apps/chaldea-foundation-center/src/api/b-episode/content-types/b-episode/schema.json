{
    "kind": "collectionType",
    "collectionName": "b_episodes",
    "info": {
        "singularName": "b-episode",
        "pluralName": "b-episodes",
        "displayName": "B - Episode"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "display_name": {
            "type": "string",
            "required": true
        },
        "languages_info": {
            "type": "json"
        },
        "parent_directory": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::b-directory.b-directory"
        },
        "watched_by": {
            "type": "json"
        },
        "version": {
            "type": "enumeration",
            "required": true,
            "default": "V1",
            "enum": ["V1", "V2"]
        },
        "file_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 5
        },
        "is_processing": {
            "type": "boolean",
            "default": false
        }
    }
}
