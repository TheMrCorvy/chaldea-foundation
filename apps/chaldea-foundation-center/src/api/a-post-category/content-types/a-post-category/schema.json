{
    "kind": "collectionType",
    "collectionName": "a_post_categories",
    "info": {
        "singularName": "a-post-category",
        "pluralName": "a-post-categories",
        "displayName": "A - Post Category"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "publishedAt": {
            "type": "datetime",
            "configurable": false
        },
        "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "required": true
        },
        "type_of_category": {
            "type": "enumeration",
            "required": true,
            "default": "blog_post",
            "enum": ["blog_post", "explicit_content", "media_content"]
        }
    }
}
