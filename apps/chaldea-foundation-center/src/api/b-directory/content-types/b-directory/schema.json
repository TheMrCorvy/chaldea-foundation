{
    "kind": "collectionType",
    "collectionName": "b_directories",
    "info": {
        "singularName": "b-directory",
        "pluralName": "b-directories",
        "displayName": "B - Directory"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "display_name": {
            "type": "string",
            "required": true
        },
        "path": {
            "type": "text",
            "required": true,
            "unique": true
        },
        "parent_directory": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::b-directory.b-directory"
        },
        "age_rating": {
            "type": "enumeration",
            "required": true,
            "default": "everyone",
            "enum": ["everyone", "explicit", "adults"]
        },
        "tags": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::a-post-category.a-post-category"
        },
        "cover": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images"]
        },
        "description": {
            "type": "text"
        },
        "is_processing": {
            "type": "boolean",
            "default": false
        }
    }
}
